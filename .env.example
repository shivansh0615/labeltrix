# Copy these into .dev.vars (local) and host secrets (production).
# Do not commit real passwords.

LABELTRIX_ADMIN_PASSWORD=Admin@123
LABELTRIX_VIEWER_PASSWORD=Viewer@123
LABELTRIX_AUTH_SECRET=change-me-to-a-long-random-string

# Neon Postgres connection string (required for products + packaging storage)
# Local: put this in .dev.vars (gitignored), not only .env
# Coolify/APICloud: set as a Runtime environment variable (exact name DATABASE_URL)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional alias accepted by the app (prefer DATABASE_URL)
# NEON_DATABASE_URL=
