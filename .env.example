# LabelTrix access passwords (shared by role, not per-user accounts)
LABELTRIX_ADMIN_PASSWORD="Kharesiya$$9911"
LABELTRIX_VIEWER_PASSWORD="Viewer@123"

# HMAC secret used to sign session cookies — change in production
LABELTRIX_AUTH_SECRET=labeltrix-dev-secret-change-me

# Neon Postgres connection string (required for products + packaging storage)
# Local: put this in .dev.vars (gitignored), not only .env
# Coolify: set as a Runtime environment variable (exact name DATABASE_URL)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional alias accepted by the app (prefer DATABASE_URL)
# NEON_DATABASE_URL=
